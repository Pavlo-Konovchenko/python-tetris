Screen {

}

Cell {
    background: $surface;
    height: 2;
    width: 100%;
    border: solid white;
}

Cell.filled {
    background: green;
}

#controls {
    height: auto;
}
#controls Select {
    width: 20;
}

#board {
    align: center middle;
    layout: grid;
    grid-columns: 2;
    grid-rows: 2;
    grid-gutter: 0;
}